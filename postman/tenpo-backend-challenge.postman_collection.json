				{
					"name": "GET /history - non-numeric page (400)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/history?page=abc&size=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"history"
							],
							"query": [
								{
									"key": "page",
									"value": "abc"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
